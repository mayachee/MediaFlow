# ==================================
# YouTube Automation - Environment
# ==================================

# --- AI Metadata Generator ---
# Free option: OpenRouter (no credit card required, sign up at openrouter.ai/keys)
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free

# --- YouTube Data API ---
# OAuth2 token pickle file (created after first auth)
YOUTUBE_TOKEN_FILE=token.pickle
# OAuth2 client secrets (download from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=client_secret.json

# --- Pinterest API ---
# OAuth2 access token (register app at developers.pinterest.com)
# Required scopes: pins:create, boards:read, media:upload
PINTEREST_ACCESS_TOKEN=
# Board ID to upload pins to (find it in the Pinterest board URL)
PINTEREST_BOARD_ID=
# Pinterest username (optional, used for board lookup)
PINTEREST_USERNAME=
